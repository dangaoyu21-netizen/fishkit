{
  "name": "dsh-fishkit",
  "version": "0.1.0",
  "description": "用经历去塑造小肥鱼的插件：聊过的事记得住，心情会变还能自己记，会自己长出性格，对谁都有好恶，闲着时还会自己找点事做。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dangaoyu21-netizen/fishkit.git"
  },
  "homepage": "https://github.com/dangaoyu21-netizen/fishkit",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "persona",
    "memory",
    "mood",
    "companion"
  ],
  "author": "dangaoyu21-netizen"
}
